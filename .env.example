# Copy to .env:  cp .env.example .env
# All values are fake and meant for a local stand only. Never commit .env.

# --- Database (PostgreSQL) ---
POSTGRES_USER=stand
# Used inside a connection URL: avoid characters like @ : / # in the password.
POSTGRES_PASSWORD=stand-password
POSTGRES_DB=stand
# Host port the database is published on. Tests use DB_HOST + POSTGRES_PORT for SQL checks.
POSTGRES_PORT=5432
DB_HOST=localhost

# --- App ---
# Host port the app is published on; keep BASE_URL in sync with it.
APP_PORT=8000
BASE_URL=http://localhost:8000
# HS256 signing key for access tokens (32+ characters).
JWT_SECRET=fake-jwt-secret-for-the-local-stand-only
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Test user ---
# Seeded by the stand on every start and read by the tests: one .env feeds both.
TEST_NAME=Test User
TEST_EMAIL=test.user@example.com
TEST_PASSWORD=test-password-123

# --- Story ---
# Password of every seeded fleet autopilot (app/data/fleet.json): exactly 4 digits.
FLEET_PASSWORD=0101
# Time zone in which the stand counts days ("not earlier than tomorrow", end of the delivery day).
STAND_TZ=UTC
# Minutes from "Autopilot is on site" to "Okay, let's fly now".
PICKUP_MINUTES=10
# Testing hooks under /api/v1/testing (per-order time shift). Off by default; CI switches it on.
TEST_HOOKS=0

# --- Seeded defects ---
# All off by default. Switch one on with BUG_<NAME>=1 (see "Known defects" in README.md).
# BUG_AUTOPILOT_LOGIN_RULES=1
# BUG_AUTOPILOT_PASSWORD_RULES=1
# BUG_AUTOPILOT_NAME_RULES=1
# BUG_MISSING_NAME_409=1
# BUG_LOGIN_NO_PASSWORD_504=1
# BUG_TRACK_DELETED_AUTOPILOT=1
# BUG_CANCELED_ORDER_VISIBLE=1
# BUG_STATUS_SEARCH_ENTER=1
# BUG_ADD_BUTTON_STALE_TOTAL=1
